# Database (PostgreSQL). Use full URL.
# When using Docker: host is the postgres service name, e.g. postgresql://postgres:postgres@postgres:5432/postgres?schema=public
# When running locally: host is localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=my-app
POSTGRES_PORT_EXT=8003

# Better Auth (required)
BETTER_AUTH_SECRET="generate-a-secure-random-string-at-least-32-chars"
BACKEND_ORIGIN="http://localhost:3000"

# Optional: CORS origin for frontend (default: http://localhost:3001)
FRONTEND_ORIGIN="http://localhost:3001"

# Optional: Server port (default: 3000)
# PORT=3000
