# Database (PostgreSQL). Use full URL.
# When using Docker: host is the postgres service name, e.g. postgresql://postgres:postgres@postgres:5432/postgres
# When running locally: host is localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=my-app
POSTGRES_PORT_EXT=8003

# Better Auth (required)
BETTER_AUTH_SECRET="generate-a-secure-random-string-at-least-32-chars"
BACKEND_ORIGIN="http://localhost:3000"

# Optional: CORS origin for frontend (default: http://localhost:3001)
FRONTEND_ORIGIN="http://localhost:3001"

# Optional: Server port (default: 3000)
# PORT=3000

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (nodemailer) — required to actually send mail; omit SMTP_HOST to skip sending (logs a warning)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=3e442380e112e8
SMTP_PASS=5a5d464c1551e1
SMTP_FROM="App <noreply@example.com>"
# Optional branding / links used in HTML templates
# COMPANY_NAME=My App
# EMAIL_COMPANY_NAME=My App
# EMAIL_SUPPORT_URL=https://example.com/support
# EMAIL_PRIVACY_URL=https://example.com/privacy
# EMAIL_TERMS_URL=https://example.com/terms
